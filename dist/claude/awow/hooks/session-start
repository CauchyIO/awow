#!/usr/bin/env bash
# SessionStart hook shim for the awow plugin — the logic lives in
# session-start.py (same pattern as lifecycle-seam-check). run-hook.cmd
# bridges Windows to this shim.
#
# Unlike the seam check, this hook carries the whole operating reflex, so a
# machine without python3 degrades LOUDLY: a banner in the injected context
# and on stderr, never a silent no-op. Exit stays 0 so a broken environment
# degrades the session instead of bricking every SessionStart.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
    msg="⚠️ awow: python3 not found — the using-awow session reflex did NOT load. Install python3, or report against CauchyIO/awow."
    printf '%s\n' "${msg}" >&2
    printf '{\n  "additionalContext": "%s"\n}\n' "${msg}"
    exit 0
fi

exec python3 "${SCRIPT_DIR}/session-start.py"
